# Docker Compose
POSTGRES_DB=publicpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
API_PORT=5000

# Application
JWT_ISSUER=PublicPulse
JWT_AUDIENCE=PublicPulse
JWT_SIGNING_KEY=replace-with-a-long-random-development-signing-key
JWT_EXPIRY_MINUTES=60
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=public-pulse/reports
CLOUDINARY_UPLOAD_PRESET=public-pulse-report-images
CLOUDINARY_MAX_IMAGES_PER_REPORT=5
MAPBOX_ACCESS_TOKEN=
CORS_ALLOWED_ORIGIN_0=http://localhost:3000
CORS_ALLOWED_ORIGIN_1=http://localhost:3001
SEED_DATA_ENABLED=true

# Direct dotnet run (not used by Compose)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=publicpulse;Username=postgres;Password=replace-with-a-local-development-password
Jwt__Issuer=PublicPulse
Jwt__Audience=PublicPulse
Jwt__SigningKey=replace-with-a-long-random-development-signing-key
Jwt__ExpiryMinutes=60
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__Folder=public-pulse/reports
Cloudinary__UploadPreset=public-pulse-report-images
Cloudinary__MaxImagesPerReport=5
Mapbox__AccessToken=
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:3001
SeedData__Enabled=false
